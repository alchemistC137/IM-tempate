@page "/account/set-password"
@layout Layout.AuthLayout
@using System.ComponentModel.DataAnnotations
@using MemByte.Application.Auth
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Activar cuenta - MemByte-IM</PageTitle>

<h1 class="h5 text-center mb-1">Fija tu contraseña</h1>
<p class="text-center text-muted small mb-4">
    Este enlace es de un solo uso. Elige una contraseña de al menos 12 caracteres, con mayúsculas,
    minúsculas, números y algún símbolo.
</p>

@if (string.IsNullOrEmpty(UserId) || string.IsNullOrEmpty(Token))
{
    <div class="alert alert-danger py-2 small" role="alert">
        El enlace no es válido. Pide a un administrador que te envíe uno nuevo.
    </div>
    <a href="/login" class="btn btn-outline-secondary w-100 py-2">Volver a iniciar sesión</a>
}
else if (succeeded)
{
    <div class="alert alert-success py-2 small" role="alert">
        Contraseña actualizada correctamente. Ya puedes iniciar sesión.
    </div>
    <a href="/login" class="btn btn-primary w-100 py-2">Iniciar sesión</a>
}
else
{
    @if (errorMessages.Count > 0)
    {
        <div class="alert alert-danger py-2 small" role="alert">
            <ul class="mb-0">
                @foreach (var error in errorMessages)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <EditForm Model="Input" FormName="set-password" OnValidSubmit="SubmitAsync" method="post" data-enhance="false">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label for="newPassword" class="form-label">Nueva contraseña</label>
            <InputText id="newPassword" type="password" class="form-control" @bind-Value="Input.NewPassword" autocomplete="new-password" />
            <ValidationMessage For="() => Input.NewPassword" class="text-danger small" />
        </div>

        <div class="mb-4">
            <label for="confirmPassword" class="form-label">Confirmar contraseña</label>
            <InputText id="confirmPassword" type="password" class="form-control" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
            <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger small" />
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2">Guardar contraseña</button>
    </EditForm>
}

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery] private string? UserId { get; set; }

    [SupplyParameterFromQuery] private string? Token { get; set; }

    [SupplyParameterFromForm(FormName = "set-password")]
    private SetPasswordInputModel Input { get; set; } = new();

    private bool succeeded;
    private List<string> errorMessages = [];

    private async Task SubmitAsync()
    {
        errorMessages = [];

        if (!Guid.TryParse(UserId, out var userId))
        {
            errorMessages.Add("El enlace no es válido o ha caducado.");
            return;
        }

        var result = await AuthService.SetPasswordAsync(new SetPasswordRequest(
            userId,
            Token ?? string.Empty,
            Input.NewPassword,
            HttpContext.Connection.RemoteIpAddress?.ToString(),
            HttpContext.Request.Headers.UserAgent.ToString()));

        if (result.Succeeded)
            succeeded = true;
        else
            errorMessages = result.Errors.ToList();
    }

    private sealed class SetPasswordInputModel
    {
        [Required(ErrorMessage = "La contraseña es obligatoria.")]
        [MinLength(12, ErrorMessage = "La contraseña debe tener al menos 12 caracteres.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirma la contraseña.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Las contraseñas no coinciden.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
