@page "/clients"
@rendermode InteractiveServer
@using MemByte.Application.Clients
@using MemByte.Infrastructure.Identity
@attribute [Authorize(Roles = ApplicationRoleNames.Admin)]
@inject IClientService ClientService
@inject NavigationManager NavigationManager

<PageTitle>Clientes - MemByte-IM</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">Gestión de clientes</h1>
        <p class="text-muted small mb-0">Clientes que agrupan a los usuarios externos de la plataforma.</p>
    </div>
    <button class="btn btn-primary btn-sm" @onclick="GoToCreate">
        <span class="bi bi-building-add me-1" aria-hidden="true"></span> Añadir cliente
    </button>
</div>

@if (loading)
{
    <div class="d-flex justify-content-center py-5">
        <span class="spinner-border" role="status" aria-hidden="true"></span>
    </div>
}
else
{
<div class="card shadow-sm">
    <div class="card-header bg-white py-2 d-flex gap-2 flex-wrap align-items-center">
        <input class="form-control form-control-sm" style="max-width:260px"
               placeholder="Buscar por nombre…"
               @bind="searchQuery" @bind:event="oninput" />

        <select class="form-select form-select-sm" style="max-width:140px" @bind="filterStatus">
            <option value="">Todos</option>
            <option value="active">Activos</option>
            <option value="inactive">Inactivos</option>
        </select>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Fecha de alta</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!FilteredClients.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            <span class="bi bi-building fs-4 d-block mb-1" aria-hidden="true"></span>
                            No se encontraron clientes con los filtros aplicados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var client in FilteredClients)
                    {
                        <tr>
                            <td>
                                <span class="fw-semibold">@client.Name</span>
                            </td>
                            <td class="small text-muted">@client.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (client.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-outline-secondary btn-sm me-1" title="Ver / editar"
                                        @onclick="() => GoToDetail(client.Id)">
                                    <span class="bi bi-pencil" aria-hidden="true"></span>
                                </button>
                                <button class="btn btn-outline-danger btn-sm" title="Eliminar"
                                        @onclick="() => ConfirmDelete(client)">
                                    <span class="bi bi-trash" aria-hidden="true"></span>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
}

@if (showDeleteModal && clientToDelete is not null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>¿Seguro que deseas eliminar al cliente <strong>@clientToDelete.Name</strong>?</p>
                    <p class="text-muted small">Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CancelDelete">Cancelar</button>
                    <button class="btn btn-danger btn-sm" @onclick="DeleteClient">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private string searchQuery = string.Empty;
    private string filterStatus = string.Empty;

    private bool loading = true;
    private bool showDeleteModal;
    private ClientDto? clientToDelete;

    private List<ClientDto> _allClients = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadClientsAsync();
    }

    private async Task LoadClientsAsync()
    {
        loading = true;
        _allClients = (await ClientService.GetAllAsync()).ToList();
        loading = false;
    }

    private List<ClientDto> FilteredClients =>
        _allClients
            .Where(c =>
                (string.IsNullOrWhiteSpace(searchQuery) ||
                 c.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrEmpty(filterStatus) ||
                 (filterStatus == "active" && c.IsActive) ||
                 (filterStatus == "inactive" && !c.IsActive)))
            .ToList();

    private void GoToCreate() => NavigationManager.NavigateTo("/clients/new");

    private void GoToDetail(Guid id) => NavigationManager.NavigateTo($"/clients/{id}");

    private void ConfirmDelete(ClientDto client)
    {
        clientToDelete = client;
        showDeleteModal = true;
    }

    private void CancelDelete()
    {
        clientToDelete = null;
        showDeleteModal = false;
    }

    private async Task DeleteClient()
    {
        if (clientToDelete is not null)
        {
            await ClientService.DeleteAsync(clientToDelete.Id);
            await LoadClientsAsync();
        }
        CancelDelete();
    }
}
