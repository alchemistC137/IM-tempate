@page "/catalog"
@rendermode InteractiveServer
@using MemByte.Application.Clients
@using MemByte.Infrastructure.Identity
@attribute [Authorize(Roles = ApplicationRoleNames.Admin)]
@inject IClientService ClientService
@inject NavigationManager NavigationManager

<PageTitle>Catálogo - MemByte-IM</PageTitle>

<div class="mb-3">
    <h1 class="h4 mb-0">Catálogo de productos y servicios</h1>
    <p class="text-muted small mb-0">
        Cada cliente de la plantilla gestiona su propio catálogo. Selecciona un
        cliente para ver y administrar sus categorías, productos y servicios.
    </p>
</div>

@if (loading)
{
    <div class="d-flex justify-content-center py-5">
        <span class="spinner-border" role="status" aria-hidden="true"></span>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-header bg-white py-2">
            <input class="form-control form-control-sm" style="max-width:260px"
                   placeholder="Buscar cliente…"
                   @bind="searchQuery" @bind:event="oninput" />
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Cliente</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!FilteredClients.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">
                                <span class="bi bi-shop fs-4 d-block mb-1" aria-hidden="true"></span>
                                No se encontraron clientes con los filtros aplicados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var client in FilteredClients)
                        {
                            <tr>
                                <td class="fw-semibold">@client.Name</td>
                                <td>
                                    @if (client.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm" title="Gestionar catálogo"
                                            @onclick="() => GoToCatalog(client.Id)">
                                        <span class="bi bi-shop me-1" aria-hidden="true"></span> Gestionar catálogo
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private string searchQuery = string.Empty;
    private bool loading = true;
    private List<ClientDto> _allClients = [];

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        _allClients = (await ClientService.GetAllAsync()).ToList();
        loading = false;
    }

    private List<ClientDto> FilteredClients =>
        _allClients
            .Where(c => string.IsNullOrWhiteSpace(searchQuery) ||
                        c.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private void GoToCatalog(Guid clientId) => NavigationManager.NavigateTo($"/catalog/{clientId}");
}
