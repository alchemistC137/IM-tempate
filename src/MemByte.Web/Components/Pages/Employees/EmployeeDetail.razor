@page "/employees/{Id:guid}"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using MemByte.Application.Employees
@using MemByte.Infrastructure.Identity
@attribute [Authorize(Roles = $"{ApplicationRoleNames.Admin},{ApplicationRoleNames.AreaManager}")]
@inject IEmployeeService EmployeeService
@inject NavigationManager NavigationManager

<PageTitle>@(employee is null ? "Empleado" : employee.FullName) - MemByte-IM</PageTitle>

<div class="mb-3">
    <a href="/employees" class="btn btn-outline-secondary btn-sm">
        <span class="bi bi-arrow-left me-1" aria-hidden="true"></span> Volver al listado
    </a>
</div>

@if (loading)
{
    <div class="d-flex justify-content-center py-5">
        <span class="spinner-border" role="status" aria-hidden="true"></span>
    </div>
}
else if (employee is null)
{
    <div class="alert alert-warning">
        <span class="bi bi-exclamation-triangle me-2" aria-hidden="true"></span>
        Empleado no encontrado.
    </div>
}
else
{
    <div class="card shadow-sm" style="max-width:600px">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h1 class="h5 mb-0">
                <span class="bi bi-person me-2" aria-hidden="true"></span>@employee.FullName
            </h1>
            @if (!editing)
            {
                <AuthorizeView Roles="@ApplicationRoleNames.Admin" Context="editCtx">
                    <button class="btn btn-outline-primary btn-sm" @onclick="StartEdit">
                        <span class="bi bi-pencil me-1" aria-hidden="true"></span> Editar
                    </button>
                </AuthorizeView>
            }
        </div>

        <div class="card-body">
            @if (saved)
            {
                <div class="alert alert-success d-flex align-items-center gap-2 py-2">
                    <span class="bi bi-check-circle-fill" aria-hidden="true"></span>
                    Datos guardados correctamente.
                </div>
            }

            @if (serverErrors.Count > 0)
            {
                <div class="alert alert-danger py-2">
                    <ul class="mb-0">
                        @foreach (var error in serverErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            @if (!editing)
            {
                <!-- Vista de sólo lectura -->
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted small">Nombre completo</dt>
                    <dd class="col-sm-8">@employee.FullName</dd>

                    <dt class="col-sm-4 text-muted small">Email</dt>
                    <dd class="col-sm-8"><a href="mailto:@employee.Email">@employee.Email</a></dd>

                    <dt class="col-sm-4 text-muted small">Departamento</dt>
                    <dd class="col-sm-8">@employee.Department</dd>

                    <dt class="col-sm-4 text-muted small">Rol</dt>
                    <dd class="col-sm-8">@RoleDisplayName(employee.Role)</dd>

                    <dt class="col-sm-4 text-muted small">Fecha de alta</dt>
                    <dd class="col-sm-8">@employee.HireDate.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-4 text-muted small">Estado</dt>
                    <dd class="col-sm-8">
                        @if (employee.IsActive)
                        {
                            <span class="badge bg-success-subtle text-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary">Inactivo</span>
                        }
                    </dd>
                </dl>
            }
            else
            {
                <!-- Formulario de edición (sólo Admin) -->
                <EditForm Model="Input" OnValidSubmit="SaveEmployee">
                    <DataAnnotationsValidator />

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label">Nombre <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="Input.FirstName" />
                            <ValidationMessage For="() => Input.FirstName" class="text-danger small" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Apellidos <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="Input.LastName" />
                            <ValidationMessage For="() => Input.LastName" class="text-danger small" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Email corporativo <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="Input.Email" type="email" />
                            <ValidationMessage For="() => Input.Email" class="text-danger small" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Departamento <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="Input.Department" />
                            <ValidationMessage For="() => Input.Department" class="text-danger small" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Rol <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="Input.Role">
                                <option value="Employee">Empleado</option>
                                <option value="AreaManager">Jefe de área</option>
                                <option value="PurchasingAgent">Agente de compras</option>
                                <option value="Admin">Admin</option>
                            </InputSelect>
                            <ValidationMessage For="() => Input.Role" class="text-danger small" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Fecha de alta <span class="text-danger">*</span></label>
                            <InputDate class="form-control" @bind-Value="Input.HireDate" />
                        </div>
                        <div class="col-sm-6 d-flex align-items-end">
                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input" @bind-Value="Input.IsActive" id="isActiveEdit" />
                                <label class="form-check-label" for="isActiveEdit">Empleado activo</label>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex gap-2 justify-content-end">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit">
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@saving">
                            @if (saving)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            }
                            Guardar cambios
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private EmployeeDto? employee;
    private EmployeeFormModel Input { get; set; } = new();
    private bool loading = true;
    private bool editing;
    private bool saving;
    private bool saved;
    private List<string> serverErrors = [];

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        employee = await EmployeeService.GetByIdAsync(Id);
        if (employee is not null)
            Input = MapToForm(employee);
        loading = false;
    }

    private void StartEdit()
    {
        saved = false;
        serverErrors = [];
        editing = true;
    }

    private void CancelEdit()
    {
        if (employee is not null)
            Input = MapToForm(employee);
        editing = false;
        saved = false;
        serverErrors = [];
    }

    private async Task SaveEmployee()
    {
        saving = true;
        serverErrors = [];

        var result = await EmployeeService.UpdateAsync(Id, new UpdateEmployeeRequest(
            Input.FirstName,
            Input.LastName,
            Input.Email,
            Input.Department,
            Input.Role,
            Input.HireDate,
            Input.IsActive));

        saving = false;

        if (result.Succeeded)
        {
            employee = result.Employee;
            saved = true;
            editing = false;
        }
        else
        {
            serverErrors = result.Errors.ToList();
        }
    }

    private static EmployeeFormModel MapToForm(EmployeeDto e) => new()
    {
        FirstName = e.FirstName,
        LastName = e.LastName,
        Email = e.Email,
        Department = e.Department,
        Role = e.Role,
        HireDate = e.HireDate,
        IsActive = e.IsActive
    };

    private static string RoleDisplayName(string role) => EmployeeRoleHelper.DisplayName(role);

    private sealed class EmployeeFormModel
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [MaxLength(100)]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Los apellidos son obligatorios.")]
        [MaxLength(100)]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "El email es obligatorio.")]
        [EmailAddress(ErrorMessage = "Introduce un email válido.")]
        [MaxLength(256)]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "El departamento es obligatorio.")]
        [MaxLength(100)]
        public string Department { get; set; } = string.Empty;

        [Required(ErrorMessage = "Selecciona un rol.")]
        public string Role { get; set; } = string.Empty;

        public DateOnly HireDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public bool IsActive { get; set; } = true;
    }
}
