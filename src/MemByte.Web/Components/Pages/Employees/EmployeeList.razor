@page "/employees"
@rendermode InteractiveServer
@using MemByte.Application.Employees
@using MemByte.Infrastructure.Identity
@attribute [Authorize(Roles = $"{ApplicationRoleNames.Admin},{ApplicationRoleNames.AreaManager}")]
@inject IEmployeeService EmployeeService
@inject NavigationManager NavigationManager

<PageTitle>Empleados - MemByte-IM</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">Gestión de empleados</h1>
        <p class="text-muted small mb-0">Listado de empleados de la organización.</p>
    </div>
    <AuthorizeView Roles="@ApplicationRoleNames.Admin">
        <button class="btn btn-primary btn-sm" @onclick="GoToCreate">
            <span class="bi bi-person-plus me-1" aria-hidden="true"></span> Añadir empleado
        </button>
    </AuthorizeView>
</div>

@if (loading)
{
    <div class="d-flex justify-content-center py-5">
        <span class="spinner-border" role="status" aria-hidden="true"></span>
    </div>
}
else
{
<div class="card shadow-sm">
    <div class="card-header bg-white py-2 d-flex gap-2 flex-wrap align-items-center">
        <input class="form-control form-control-sm" style="max-width:260px"
               placeholder="Buscar por nombre, email o departamento…"
               @bind="searchQuery" @bind:event="oninput" />

        <select class="form-select form-select-sm" style="max-width:160px" @bind="filterRole">
            <option value="">Todos los roles</option>
            <option value="Admin">Admin</option>
            <option value="AreaManager">Jefe de área</option>
            <option value="PurchasingAgent">Agente de compras</option>
            <option value="Employee">Empleado</option>
        </select>

        <select class="form-select form-select-sm" style="max-width:140px" @bind="filterStatus">
            <option value="">Todos</option>
            <option value="active">Activos</option>
            <option value="inactive">Inactivos</option>
        </select>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Departamento</th>
                    <th>Rol</th>
                    <th>Fecha de alta</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!FilteredEmployees.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <span class="bi bi-people fs-4 d-block mb-1" aria-hidden="true"></span>
                            No se encontraron empleados con los filtros aplicados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var emp in PagedEmployees)
                    {
                        <tr>
                            <td>
                                <span class="fw-semibold">@emp.FullName</span>
                            </td>
                            <td class="text-muted small">@emp.Email</td>
                            <td class="small">@emp.Department</td>
                            <td><span class="badge @RoleBadgeClass(emp.Role)">@RoleDisplayName(emp.Role)</span></td>
                            <td class="small text-muted">@emp.HireDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (emp.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-outline-secondary btn-sm me-1" title="Ver / editar"
                                        @onclick="() => GoToDetail(emp.Id)">
                                    <span class="bi bi-pencil" aria-hidden="true"></span>
                                </button>
                                <AuthorizeView Roles="@ApplicationRoleNames.Admin" Context="deleteCtx">
                                    <button class="btn btn-outline-danger btn-sm" title="Eliminar"
                                            @onclick="() => ConfirmDelete(emp)">
                                        <span class="bi bi-trash" aria-hidden="true"></span>
                                    </button>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
            <small class="text-muted">
                Mostrando @(((currentPage - 1) * pageSize) + 1)–@(Math.Min(currentPage * pageSize, _filteredCache.Count))
                de @_filteredCache.Count empleados
            </small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => currentPage--">‹</button>
                    </li>
                    @for (int p = 1; p <= TotalPages; p++)
                    {
                        int pageNum = p;
                        <li class="page-item @(currentPage == pageNum ? "active" : "")">
                            <button class="page-link" @onclick="() => currentPage = pageNum">@pageNum</button>
                        </li>
                    }
                    <li class="page-item @(currentPage == TotalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => currentPage++">›</button>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
}

@if (showDeleteModal && employeeToDelete is not null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>¿Seguro que deseas eliminar a <strong>@employeeToDelete.FullName</strong>?</p>
                    <p class="text-muted small">Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CancelDelete">Cancelar</button>
                    <button class="btn btn-danger btn-sm" @onclick="DeleteEmployee">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private string searchQuery = string.Empty;
    private string filterRole = string.Empty;
    private string filterStatus = string.Empty;
    private int currentPage = 1;
    private const int pageSize = 10;

    private bool loading = true;
    private bool showDeleteModal;
    private EmployeeDto? employeeToDelete;

    private List<EmployeeDto> _allEmployees = [];

    // Materialised once per state change to avoid re-evaluating the LINQ
    // query on every property access within the same render cycle.
    private List<EmployeeDto> _filteredCache = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployeesAsync();
    }

    private async Task LoadEmployeesAsync()
    {
        loading = true;
        _allEmployees = (await EmployeeService.GetAllAsync()).ToList();
        loading = false;
    }

    private List<EmployeeDto> FilteredEmployees
    {
        get
        {
            _filteredCache = _allEmployees
                .Where(e =>
                    (string.IsNullOrWhiteSpace(searchQuery) ||
                     e.FullName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                     e.Email.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                     e.Department.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) &&
                    (string.IsNullOrEmpty(filterRole) || e.Role == filterRole) &&
                    (string.IsNullOrEmpty(filterStatus) ||
                     (filterStatus == "active" && e.IsActive) ||
                     (filterStatus == "inactive" && !e.IsActive)))
                .ToList();
            return _filteredCache;
        }
    }

    private IEnumerable<EmployeeDto> PagedEmployees =>
        _filteredCache.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private int TotalPages => (int)Math.Ceiling(_filteredCache.Count / (double)pageSize);

    private void GoToCreate() => NavigationManager.NavigateTo("/employees/new");

    private void GoToDetail(Guid id) => NavigationManager.NavigateTo($"/employees/{id}");

    private void ConfirmDelete(EmployeeDto emp)
    {
        employeeToDelete = emp;
        showDeleteModal = true;
    }

    private void CancelDelete()
    {
        employeeToDelete = null;
        showDeleteModal = false;
    }

    private async Task DeleteEmployee()
    {
        if (employeeToDelete is not null)
        {
            await EmployeeService.DeleteAsync(employeeToDelete.Id);
            await LoadEmployeesAsync();

            var remaining = _allEmployees.Count;
            if (currentPage > Math.Ceiling(remaining / (double)pageSize) && currentPage > 1)
                currentPage--;
        }
        CancelDelete();
    }

    private static string RoleBadgeClass(string role) => EmployeeRoleHelper.BadgeClass(role);

    private static string RoleDisplayName(string role) => EmployeeRoleHelper.DisplayName(role);
}
