@page "/users"
@rendermode InteractiveServer
@using MemByte.Application.Users
@using MemByte.Infrastructure.Identity
@attribute [Authorize(Roles = ApplicationRoleNames.Admin)]
@inject IUserService UserService
@inject NavigationManager NavigationManager

<PageTitle>Usuarios - @Intranet.Value.ApplicationName</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">Gestión de usuarios</h1>
        <p class="text-muted small mb-0">Cuentas de acceso de empleados y de usuarios de cliente.</p>
    </div>
    <a href="/users/new" class="btn btn-primary btn-sm">
        <span class="bi bi-person-plus me-1" aria-hidden="true"></span> Nuevo usuario
    </a>
</div>

@if (loading)
{
    <div class="d-flex justify-content-center py-5">
        <span class="spinner-border" role="status" aria-hidden="true"></span>
    </div>
}
else
{
<div class="card shadow-sm">
    <div class="card-header bg-white py-2 d-flex gap-2 flex-wrap align-items-center">
        <input class="form-control form-control-sm" style="max-width:260px"
               placeholder="Buscar por nombre o email…"
               @bind="searchQuery" @bind:event="oninput" />

        <select class="form-select form-select-sm" style="max-width:160px" @bind="filterRole">
            <option value="">Todos los roles</option>
            <option value="Admin">Admin</option>
            <option value="AreaManager">Jefe de área</option>
            <option value="PurchasingAgent">Agente de compras</option>
            <option value="Employee">Empleado</option>
        </select>

        <select class="form-select form-select-sm" style="max-width:160px" @bind="filterType">
            <option value="">Todos los tipos</option>
            <option value="employee">Vinculado a empleado</option>
            <option value="client">Usuario de cliente</option>
            <option value="none">Sin vincular</option>
        </select>

        <select class="form-select form-select-sm" style="max-width:140px" @bind="filterStatus">
            <option value="">Todos</option>
            <option value="active">Activos</option>
            <option value="inactive">Inactivos</option>
        </select>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Usuario</th>
                    <th>Vínculo</th>
                    <th>Roles</th>
                    <th>Último acceso</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!FilteredUsers.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <span class="bi bi-person-badge fs-4 d-block mb-1" aria-hidden="true"></span>
                            No se encontraron usuarios con los filtros aplicados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var user in FilteredUsers)
                    {
                        <tr>
                            <td>
                                <span class="fw-semibold d-block">@user.DisplayName</span>
                                <span class="text-muted small">@user.Email</span>
                            </td>
                            <td class="small">
                                @if (user.EmployeeId is not null)
                                {
                                    <span class="badge bg-info-subtle text-info">Empleado: @user.EmployeeFullName</span>
                                }
                                else if (user.ClientId is not null)
                                {
                                    <span class="badge bg-primary-subtle text-primary">Cliente: @user.ClientName</span>
                                }
                                else
                                {
                                    <span class="text-muted">— Sin vincular —</span>
                                }
                            </td>
                            <td class="small">
                                @if (user.Roles.Count == 0)
                                {
                                    <span class="text-muted">Sin roles</span>
                                }
                                else
                                {
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary me-1">@RoleDisplayName(role)</span>
                                    }
                                }
                            </td>
                            <td class="small text-muted">
                                @(user.LastLoginAt is null ? "Nunca" : user.LastLoginAt.Value.LocalDateTime.ToString("dd/MM/yyyy HH:mm"))
                            </td>
                            <td>
                                @if (!user.IsActive)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Inactivo</span>
                                }
                                else if (user.IsLockedOut)
                                {
                                    <span class="badge bg-warning-subtle text-warning">Bloqueado temporalmente</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success">Activo</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-outline-secondary btn-sm" title="Ver / editar"
                                        @onclick="() => GoToDetail(user.Id)">
                                    <span class="bi bi-pencil" aria-hidden="true"></span>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
}

@code {
    private string searchQuery = string.Empty;
    private string filterRole = string.Empty;
    private string filterType = string.Empty;
    private string filterStatus = string.Empty;

    private bool loading = true;
    private List<UserDto> _allUsers = [];

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        _allUsers = (await UserService.GetAllAsync()).ToList();
        loading = false;
    }

    private List<UserDto> FilteredUsers =>
        _allUsers
            .Where(u =>
                (string.IsNullOrWhiteSpace(searchQuery) ||
                 u.DisplayName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                 u.Email.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrEmpty(filterRole) || u.Roles.Contains(filterRole)) &&
                (string.IsNullOrEmpty(filterType) ||
                 (filterType == "employee" && u.EmployeeId is not null) ||
                 (filterType == "client" && u.ClientId is not null) ||
                 (filterType == "none" && u.EmployeeId is null && u.ClientId is null)) &&
                (string.IsNullOrEmpty(filterStatus) ||
                 (filterStatus == "active" && u.IsActive) ||
                 (filterStatus == "inactive" && !u.IsActive)))
            .ToList();

    private void GoToDetail(Guid id) => NavigationManager.NavigateTo($"/users/{id}");

    private static string RoleDisplayName(string role) => role switch
    {
        "Admin" => "Admin",
        "AreaManager" => "Jefe de área",
        "PurchasingAgent" => "Ag. compras",
        "Employee" => "Empleado",
        _ => role
    };
}
