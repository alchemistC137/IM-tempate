@page "/forgot-password"
@layout Layout.AuthLayout

<PageTitle>Recuperar contraseña - @Intranet.Value.ApplicationName</PageTitle>

<h1 class="h5 text-center mb-1">Recuperar contraseña</h1>
<p class="text-center text-muted small mb-4">
    Esta funcionalidad estará disponible próximamente. Mientras tanto, contacta con un administrador
    para restablecer tu contraseña.
</p>

<a href="/login" class="btn btn-primary w-100 py-2">Volver a iniciar sesión</a>
