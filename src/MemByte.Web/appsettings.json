{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Messaging": {
    "RetentionYears": 5,
    "RetentionEnabled": true,
    "MaxAttachmentSizeBytes": 10485760,
    "MaxAttachmentsPerMessage": 5,
    "AttachmentStorage": {
      "ConnectionString": "",
      "ContainerName": "messaging-attachments"
    }
  }
}
